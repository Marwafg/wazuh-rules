<group name="defense_evasion,log_clearing,windows">

  <rule id="100065" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$</field>
    <description>Security Event Log Cleared - possible evidence removal</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,log_cleared,critical_severity</group>
  </rule>

  <rule id="100066" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^104$</field>
    <description>System Event Log Cleared - possible evidence removal</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,log_cleared,high_severity</group>
  </rule>

  <rule id="100067" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <match>wevtutil</match>
    <match>cl </match>
    <description>wevtutil log clear command executed</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,wevtutil</group>
  </rule>

  <rule id="100068" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <match>Clear-EventLog</match>
    <description>PowerShell Clear-EventLog command detected</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,powershell_log_clear</group>
  </rule>

  <rule id="100069" level="15" frequency="2" timeframe="300">
    <if_matched_sid>100065</if_matched_sid>
    <description>Multiple log clearing events - sustained evidence removal</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,log_cleared,critical_severity</group>
  </rule>

</group>
